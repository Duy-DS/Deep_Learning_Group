\section{Phân chia dữ liệu và phòng tránh rò rỉ}
\begin{longtable}{p{0.23\textwidth}p{0.47\textwidth}r}
\toprule Split & Vai trò trong pipeline & Số ảnh \\
\midrule
\endfirsthead
\toprule Split & Vai trò trong pipeline & Số ảnh \\
\midrule
\endhead
Training & Cập nhật tham số; augmentation chỉ áp dụng ở nhánh này & 28.709 \\
PublicTest & Validation/model selection; transform đánh giá xác định & 3.589 \\
PrivateTest & Đánh giá cuối sau chọn checkpoint; transform xác định & 3.589 \\
\bottomrule
