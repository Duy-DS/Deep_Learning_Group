# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Virtual environments
.venv/
venv/
env/

# Data rules (Ignore heavy datasets, keep doc and tracking files)
*.csv
*.zip
*.tar.gz
*.tgz
.env
.env.*
!.env.example
access_token
kaggle.json
data/raw/*
data/processed/*
data/**/*.zip
data/**/*.tar.gz
data/**/*.tgz
!data/README.md
!data/raw/.gitkeep
!data/processed/.gitkeep
!**/.gitkeep

# Model weights & Checkpoints
*.pth
*.pt
*.ckpt
*.onnx

# Program outputs & artifacts (Ignore generated files but preserve directory structure)
outputs/**
!outputs/**/
!**/.gitkeep

# Experiment tracking & Personal drafts
mlruns/
mlartifacts/
drafts/

# OS generated files
.DS_Store
Thumbs.db

# Temporary & intermediate output caches
.pytest_cache/

# Thesis/Overleaf build artifacts (không commit bundle hoặc file biên dịch)
#docs/thesis/overleaf_bundle/
#docs/thesis/build/
#docs/thesis/*.zip
*.aux
*.log
*.out
*.toc
*.bbl
*.blg

# Thesis sources, policies, references and generated TeX tables remain trackable
#!docs/thesis/AGENTS_THESIS.md
#!docs/thesis/samples/
#!docs/thesis/samples/**
#!docs/thesis/templates/
#!docs/thesis/templates/**
#!docs/thesis/generated/
#!docs/thesis/generated/**

# Evidence tracking & templates in docs/
!docs/
!docs/**/
!docs/**/*.md
!docs/**/.gitkeep

# Luật cuối: artifacts thesis luôn bị ignore sau các ngoại lệ chung của docs/
#docs/thesis/overleaf_bundle/
#docs/thesis/overleaf_bundle/**
#docs/thesis/build/
#docs/thesis/build/**
#docs/thesis/*.zip
#docs/thesis/**/*.aux
#docs/thesis/**/*.log
#docs/thesis/**/*.out
#docs/thesis/**/*.toc
#docs/thesis/**/*.bbl
#docs/thesis/**/*.blg
#docs/thesis/samples/
#docs/thesis/samples/**
