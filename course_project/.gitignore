# Byte-compiled / cache của Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Trọng số mô hình & Artifacts nặng (Tuyệt đối không đẩy lên Git)
*.pth
*.pt
*.onnx
*.ckpt
*.h5
*.pkl
*.csv
*.parquet
*.feather
*.log
*.zip
checkpoints/
weights/
backups/

# Môi trường ảo & Biến môi trường (Bảo vệ bí mật .env, giữ .env.example)
venv/
.venv/
env/
.env
.env.*
!.env.example

# Giữ khung thư mục dữ liệu bằng .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/preprocess/*
!data/preprocess/.gitkeep
data/preprocess_test/

# Giữ khung thư mục đầu ra & MLflow bằng .gitkeep
outputs/*
!outputs/.gitkeep
!outputs/checkpoints/
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
!outputs/logs/
outputs/logs/*
!outputs/logs/.gitkeep
!outputs/ablation/
outputs/ablation/*
!outputs/ablation/.gitkeep
!outputs/reports/
outputs/reports/*
!outputs/reports/.gitkeep
mlruns/*
!mlruns/.gitkeep

# Thư mục kiểm thử Smoke Test tạm thời (tuyệt đối không đưa lên Git)
outputs_test/
mlruns_test/
backups_test/

# Jupyter Notebook checkpoints & Giữ notebook Cloud GPU
.ipynb_checkpoints/
!notebooks/colab/*.ipynb
!notebooks/kaggle/*.ipynb

# Thư mục log tạm của trình huấn luyện (TensorBoard / WandB)
runs/
wandb/
lightning_logs/

# Hệ điều hành & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# BẢO VỆ HỆ THỐNG BẰNG CHỨNG: Luôn cho phép Git theo dõi toàn bộ thư mục docs/
!docs/
!docs/**/
!docs/**/*.md
!docs/**/.gitkeep
