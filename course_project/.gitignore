# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Virtual environments & temporary runs/logs
.venv/
venv/
env/
runs/
wandb/

# Model weights & Checkpoints (tránh làm phình to repo Git)
*.pth
*.pt
*.onnx
checkpoints/
weights/

# Scikit-learn / Joblib / Pickle models
# *.pkl
# *.joblib

# OS generated files
.DS_Store
Thumbs.db

# Temporary & intermediate output caches
.pytest_cache/

# Cho phép Git theo dõi các báo cáo trong docs
!docs/
!docs/reports/*.md
!docs/dev-logs/*.md
!docs/experiences/*.md
!docs/bug-fixes/*.md
