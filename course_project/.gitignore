# Byte-compiled / cache của Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Trọng số mô hình & artifacts nặng (không đẩy lên Git)
*.pth
*.pt
*.onnx
*.ckpt
*.h5
checkpoints/
weights/
outputs/checkpoints/

# Dữ liệu raw/processed (chỉ giữ .gitkeep trong hai thư mục chuẩn)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.parquet
*.feather

# Môi trường cục bộ
venv/
.venv/
env/
.env

# Notebook, log tạm, hệ điều hành và IDE
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
runs/
wandb/
lightning_logs/
.DS_Store
Thumbs.db
.vscode/
.idea/
.ignore/

# Bằng chứng Markdown và thư mục docs luôn được phép theo dõi
!docs/
!docs/**/
!docs/**/*.md
!docs/**/.gitkeep
!docs/**/*.yaml